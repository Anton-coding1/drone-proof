# Starts the sensor at boot and restarts it if it stops.
# Install:  sudo cp deploy/witnessmark-sensor.service /etc/systemd/system/
#           sudo systemctl enable --now witnessmark-sensor
# Logs:     journalctl -u witnessmark-sensor -f
[Unit]
Description=Witnessmark receive-only GNSS interference sensor
After=network-online.target

[Service]
User=pi
WorkingDirectory=/home/pi/witnessmark
ExecStart=/usr/bin/python3 /home/pi/witnessmark/witnessmark_sensor.py run --port /dev/ttyACM0 --site site-01
Restart=always
RestartSec=10
# Hardening: the sensor only needs its own folder and the USB receiver.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/pi/witnessmark
PrivateTmp=true
SupplementaryGroups=dialout

[Install]
WantedBy=multi-user.target
